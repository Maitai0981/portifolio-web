{
  "name": "portifolio-web-root",
  "private": true,
  "description": "Root command launcher for organized app/config layout",
  "scripts": {
    "install:config": "npm --prefix config install",
    "dev": "npm --prefix config run dev",
    "start": "npm --prefix config run start",
    "lint": "npm --prefix config run lint",
    "test": "npm --prefix config test",
    "test:soak": "npm --prefix config run test:soak",
    "test:e2e": "npm --prefix config run test:e2e",
    "test:e2e:headed": "npm --prefix config run test:e2e:headed",
    "test:e2e:install": "npm --prefix config run test:e2e:install",
    "build": "npm --prefix config run build",
    "project:map": "npm --prefix config run project:map",
    "worker:dev": "npm --prefix config run worker:dev",
    "worker:deploy": "npm --prefix config run worker:deploy",
    "worker:tail": "npm --prefix config run worker:tail",
    "postinstall": "npm run install:config",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}
